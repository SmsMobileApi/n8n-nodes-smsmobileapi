{
  "name": "n8n-nodes-smsmobileapi",
  "version": "0.1.1",
  "description": "SMSMobileAPI nodes for SMS, calls, and connected mobiles",
  "license": "MIT",
  "author": {
    "name": "SMSMobileAPI",
    "email": "support@smsmobileapi.com"
  },
  "homepage": "https://smsmobileapi.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmsMobileApi/n8n-nodes-smsmobileapi.git"
  },
  "bugs": {
    "url": "https://github.com/SmsMobileApi/n8n-nodes-smsmobileapi/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "smsmobileapi",
    "sms",
    "mobile-gateway",
    "call-logs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --test tests/*.test.cjs",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SmsMobileApiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SmsMobileApi/SmsMobileApi.node.js",
      "dist/nodes/SmsMobileApiTrigger/SmsMobileApiTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.58.7",
    "n8n-workflow": "^2.49.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
